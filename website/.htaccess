# Servereinstellungen fuer den echten Webserver (Apache, z. B. All-Inkl).
# Auf der GitHub-Vorschau wird diese Datei ignoriert. VOR DEM LIVEGANG auf dem Server testen.

RewriteEngine On

# Die Uebergangsadresse des Hosters (…kasserver.com) NICHT umleiten.
# Sonst laesst sich die Seite vor dem Domain-Umzug nicht auf dem echten
# Server testen - jeder Aufruf landet sofort wieder auf der alten Seite.
# Diese Regel muss VOR der Umleitung stehen und bleibt auch nach dem
# Livegang drin: sie stoert nicht und rettet den naechsten Test.
RewriteCond %{HTTP_HOST} \.kasserver\.com$ [NC]
RewriteRule ^ - [L]

# --- Immer https, ohne www (die bisherige Seite lief ohne www, so bleibt Google-Ranking erhalten) ---
# ERST AM LIVEGANG-TAG freischalten (Rauten entfernen). Vorher nicht.
# RewriteCond %{HTTPS} !=on [OR]
# RewriteCond %{HTTP_HOST} ^www\. [NC]
# RewriteRule ^(.*)$ https://zahnzentrum-messerschmidt.de/$1 [R=301,L]

# --- Alte Adressen der bisherigen WordPress-Seite (ausgelesen 06.10.2026) ---
# Jede alte Adresse zeigt dauerhaft (301) auf die passende neue Seite. Greift erst auf dem echten Server.
RedirectMatch 301 ^/uber-uns(/.*)?$                         /team.html
RedirectMatch 301 ^/miller-zahnaerztin-in-mainz-laubenheim/?$ /team.html#miller
RedirectMatch 301 ^/zahnaerztin-mainz-laubenheim/?$          /team.html#blatt
RedirectMatch 301 ^/praxis/.+$                              /praxis.html
RedirectMatch 301 ^/praxis/?$                               /praxis.html
RedirectMatch 301 ^/leistungen/?$                           /leistungen.html
RedirectMatch 301 ^/leistungen/([a-z-]+)/?$                 /leistungen/$1.html
RedirectMatch 301 ^/wp/qualifiziert/([a-z-]+)/?$            /leistungen/$1.html
RedirectMatch 301 ^/service/patienteninfos/?$               /patienteninfos.html
RedirectMatch 301 ^/service/patenschaft-fuer-kindergaerten/?$ /leistungen/junge-zaehne.html
RedirectMatch 301 ^/service(/.*)?$                          /praxis.html
RedirectMatch 301 ^/neues-aus-der-praxis/?$                 /
RedirectMatch 301 ^/(kontakt|anfahrt)/?$                    /kontakt.html
RedirectMatch 301 ^/impressum/?$                            /impressum.html
RedirectMatch 301 ^/datenschutz/?$                          /datenschutz.html
RedirectMatch 301 ^/app/uploads/.*$                         /

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png  "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType video/webm "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

Options -Indexes

<IfModule mod_headers.c>
  # HTML nie zwischenspeichern: sonst sehen Besucher (und wir beim
  # Testen) nach einer Aenderung stundenlang die alte Seite.
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
